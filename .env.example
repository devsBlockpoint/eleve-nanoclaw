# =============================================================================
# eleve-nanoclaw — variables de entorno
# =============================================================================
# Copiá este archivo a .env y completá con valores reales antes de levantar
# `docker compose up`. NO commitear .env (está en .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# nanoclaw (agent runtime)
# -----------------------------------------------------------------------------

# Puerto en el que nanoclaw expone su HTTP API (POST /messages, GET /health)
NANOCLAW_PORT=3001

# Bearer token que ÉLEVÉ envía al llamar a POST /messages.
# Reusa el token que hoy ÉLEVÉ envía a n8n / chat-assistant para no tocar
# nada del lado Supabase.
AGENT_INBOUND_TOKEN=

# Credenciales de Anthropic. Usar UNA de las dos opciones.
# Opción 1: API key directa
ANTHROPIC_API_KEY=
# Opción 2: vía proxy (ej. OneCLI Agent Vault)
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# Agent group único en v1
AGENT_GROUP=monica

# Sistema de carga del system prompt. Elegir UNA fuente:
#   env  → leer de AGENT_SYSTEM_PROMPT (string completo)
#   file → leer del archivo en AGENT_SYSTEM_PROMPT_PATH (mount de volumen)
#   url  → fetch desde AGENT_SYSTEM_PROMPT_URL (opcional auth + cache)
AGENT_SYSTEM_PROMPT_SOURCE=env

# Si AGENT_SYSTEM_PROMPT_SOURCE=env:
AGENT_SYSTEM_PROMPT=

# Si AGENT_SYSTEM_PROMPT_SOURCE=file:
# AGENT_SYSTEM_PROMPT_PATH=/data/system-prompt.md

# Si AGENT_SYSTEM_PROMPT_SOURCE=url:
# AGENT_SYSTEM_PROMPT_URL=
# AGENT_SYSTEM_PROMPT_URL_AUTH=        # opcional, ej. "Bearer xxx"

# Hot-reload del system prompt (segundos). 0 = off (default).
AGENT_SYSTEM_PROMPT_RELOAD_INTERVAL=0

# URL interna del MCP server mcp-monica (red de docker compose)
MCP_MONICA_URL=http://mcp-monica:3000

# Endpoint y bearer para enviar respuestas hacia ÉLEVÉ
ELEVE_OUTBOUND_URL=https://YOUR_PROJECT.supabase.co/functions/v1/n8n-whatsapp-agent-response
ELEVE_OUTBOUND_TOKEN=

# Expediente vivo (A01) — memoria de la persona entre canales.
# Apuntan a la edge function `patient-context` de Supabase, que resuelve quién
# escribe y devuelve lo que ya se habló con esa persona (por chat o por teléfono)
# para que Mónica no la atienda como si fuera la primera vez.
#
# OPT-IN: si se dejan vacías, nanoclaw se comporta igual que antes — cada
# conversación arranca en frío. Una variable faltante degrada el expediente,
# NUNCA rompe la entrada de mensajes.
ELEVE_PATIENT_CONTEXT_URL=
ELEVE_PATIENT_CONTEXT_TOKEN=


# -----------------------------------------------------------------------------
# mcp-monica (MCP server)
# -----------------------------------------------------------------------------

# Puerto interno del MCP server (NO se expone al host en producción)
MCP_MONICA_PORT=3000

# URL del proyecto Supabase de ÉLEVÉ
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Service role key — permite invocar edge functions con auth=service_role
# CUIDADO: secreto crítico. Solo en .env, nunca en repo.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token que protege el endpoint /mcp (opt-in).
#   - Vacío/sin setear = guard DESACTIVADO. Solo seguro si /mcp vive en red
#     privada (como hoy: solo nanoclaw lo alcanza en la red de docker compose).
#   - REQUERIDO antes de exponer /mcp a un cliente MCP externo (ej. ElevenLabs)
#     por internet público. El cliente debe mandar `Authorization: Bearer <token>`.
#     Si lo activás, nanoclaw también debe enviarlo al llamar a MCP_MONICA_URL.
MCP_AUTH_TOKEN=

# Secreto para verificar la firma HMAC del webhook post-call de ElevenLabs.
# Lo genera ElevenLabs al crear el webhook. Vacío = verificación DESACTIVADA.
ELEVENLABS_WEBHOOK_SECRET=

# Edge function opcional a la que reenviar el payload post-call (transcripts).
# Vacío = solo se registra el resultado en el log.
ELEVEN_POSTCALL_EDGE_FN=

# --- Proyector de prompt (fuente única -> proyección por canal) ---
#
# URL de exportación en TEXTO del documento maestro de Mónica. Al setearla,
# mcp-monica expone GET /prompt/texto con la proyección para nanoclaw.
# Vacía = proyector desactivado (el endpoint responde 503 y nanoclaw sigue con
# la fuente que tenga configurada hoy).
#   ej: https://docs.google.com/document/d/<DOC_ID>/export?format=txt
MONICA_PROMPT_MASTER_URL=

# Carpeta con las reglas por canal (canal-texto.md / canal-voz.md).
# Por defecto usa ./prompt dentro de la imagen; solo se cambia en dev.
# MONICA_PROMPT_DIR=
